#!/bin/sh
# takeoff gate (METHOD T7): judge each pushed ref's tip commit in an isolated clone.
# The judge is the installed takeoff, not the branch being pushed. Push runs the fast lane;
# `.githooks/land` runs the full series at landing and the installed `bin/land-pr` merges through it.
TAKEOFF="${TAKEOFF_HOME:-$HOME/Development/skillbox-sources/takeoff}"
GATE="${TAKEOFF_GATE_BIN:-$TAKEOFF/bin/gate}"
if [ ! -x "$GATE" ]; then
  echo "takeoff gate: REFUSED — no gate at $GATE (install takeoff or set TAKEOFF_HOME)" >&2
  exit 1
fi
exec "$GATE" pre-push "$1" "$2" --warm node_modules=package-lock.json \
  --lane A-unit --run 'npm test' --marker '^ℹ pass ([0-9]+)$' --floor 44
