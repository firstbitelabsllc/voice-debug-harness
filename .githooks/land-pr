#!/bin/sh
# takeoff merge door: `.githooks/land-pr <pr>` merges only when this head's land receipt, the
# CodeRabbit review at this head and the required checks all pass; otherwise it makes no merge.
TAKEOFF="${TAKEOFF_HOME:-$HOME/Development/takeoff}"
[ -x "$TAKEOFF/bin/land-pr" ] || {
  echo "takeoff land-pr: REFUSED — install takeoff at $TAKEOFF (bin/land-pr)" >&2; exit 1; }
exec "$TAKEOFF/bin/land-pr" "$@" --method squash \
  --require-lane A-unit --require-lane B-package \
  --require-lane D-quality --require-lane E-architecture --require-lane F-product
